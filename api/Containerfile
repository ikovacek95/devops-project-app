# =============================================================================
# API servis - multi-stage build (Podman / Docker kompatibilan)
#
# Stageovi:
#   deps    -> instalira SAMO produkcijske ovisnosti (npm ci --omit=dev)
#   dev     -> instalira i dev-ovisnosti (nodemon) za hot-reload u compose.dev.yaml
#   runtime -> minimalna finalna slika, non-root korisnik, bez build alata
# =============================================================================

# Bazna slika je pinana na minor verziju (20.20) i verziju Alpinea (3.22)
# kako bi build bio reproducibilan i kako bi hadolint pravilo DL3006/DL3007 prošlo.
ARG NODE_IMAGE=docker.io/library/node:20.20-alpine3.22

# -----------------------------------------------------------------------------
# Stage 1: deps - produkcijske ovisnosti
# -----------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS deps

WORKDIR /app

# Kopiramo samo manifeste kako bi se Docker/Podman layer cache poništio
# tek kad se stvarno promijene ovisnosti, a ne pri svakoj promjeni koda.
COPY package.json package-lock.json ./

# npm ci zahtijeva package-lock.json i garantira determinističku instalaciju.
RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force

# -----------------------------------------------------------------------------
# Stage 2: dev - koristi se samo za lokalni razvoj (hot-reload)
# -----------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS dev

ENV NODE_ENV=development \
    NPM_CONFIG_CACHE=/tmp/.npm

WORKDIR /app

RUN addgroup -S app && adduser -S -u 10001 -G app app

COPY --chown=app:app package.json package-lock.json ./

# U dev stageu trebamo i devDependencies (nodemon) pa NE koristimo --omit=dev.
RUN npm ci --ignore-scripts \
    && npm cache clean --force \
    && chown -R app:app /app

COPY --chown=app:app src ./src

USER 10001

EXPOSE 8080

CMD ["npx", "nodemon", "src/server.js"]

# -----------------------------------------------------------------------------
# Stage 3: runtime - finalna produkcijska slika
# -----------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime

ENV NODE_ENV=production \
    API_PORT=8080 \
    NPM_CONFIG_CACHE=/tmp/.npm

WORKDIR /app

# Non-root korisnik s FIKSNIM numeričkim UID-om 10001.
# Numerički UID je važan jer Kubernetes `runAsNonRoot` provjerava UID, a ne ime.
RUN addgroup -S app && adduser -S -u 10001 -G app app

# node_modules dolazi iz deps stagea - u finalnoj slici nema npm cachea ni build alata.
COPY --from=deps --chown=app:app /app/node_modules ./node_modules
COPY --chown=app:app package.json package-lock.json ./
COPY --chown=app:app src ./src

USER 10001

EXPOSE 8080

# Healthcheck koristi wget iz busyboxa (već postoji u alpine slici, nema dodatnih paketa).
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD wget -q --spider "http://127.0.0.1:${API_PORT:-8080}/healthz" || exit 1

CMD ["node", "src/server.js"]
