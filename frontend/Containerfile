# =============================================================================
# Frontend servis - multi-stage build (Podman / Docker kompatibilan)
#
# Stageovi:
#   deps    -> instalira SAMO produkcijske ovisnosti (npm ci --omit=dev)
#   dev     -> instalira i dev-ovisnosti (nodemon) za hot-reload u compose.dev.yaml
#   runtime -> minimalna finalna slika, non-root korisnik, bez build alata
# =============================================================================

ARG NODE_IMAGE=docker.io/library/node:20.20-alpine3.22

# -----------------------------------------------------------------------------
# Stage 1: deps - produkcijske ovisnosti
# -----------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS deps

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force

# -----------------------------------------------------------------------------
# Stage 2: dev - koristi se samo za lokalni razvoj (hot-reload)
# -----------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS dev

ENV NODE_ENV=development \
    NPM_CONFIG_CACHE=/tmp/.npm

WORKDIR /app

RUN addgroup -S app && adduser -S -u 10001 -G app app

COPY --chown=app:app package.json package-lock.json ./

RUN npm ci --ignore-scripts \
    && npm cache clean --force \
    && chown -R app:app /app

COPY --chown=app:app src ./src

USER 10001

EXPOSE 3000

CMD ["npx", "nodemon", "src/server.js"]

# -----------------------------------------------------------------------------
# Stage 3: runtime - finalna produkcijska slika
# -----------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime

ENV NODE_ENV=production \
    FRONTEND_PORT=3000 \
    NPM_CONFIG_CACHE=/tmp/.npm

WORKDIR /app

# Non-root korisnik s FIKSNIM numeričkim UID-om 10001 (isti kao u K8s securityContextu).
RUN addgroup -S app && adduser -S -u 10001 -G app app

COPY --from=deps --chown=app:app /app/node_modules ./node_modules
COPY --chown=app:app package.json package-lock.json ./
COPY --chown=app:app src ./src

USER 10001

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -q --spider "http://127.0.0.1:${FRONTEND_PORT:-3000}/healthz" || exit 1

CMD ["node", "src/server.js"]
